BOT_ENABLED=true
SESSION_DIR=./sessions/thi-local
LOG_LEVEL=warn

# Supabase Project Settings > API; do not share these values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SERVICE-ROLE-KEY

# SAFE DEFAULT: bot will not auto-reply until an authorized test contact is listed.
# Enter full WhatsApp JID or phone number without +, comma-separated.
# For @lid senders, copy the full JID shown in terminal for a blocked test message.
BOT_ALLOWED_CONTACTS=947XXXXXXXX
